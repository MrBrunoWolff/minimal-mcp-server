{
  "name": "@mrbrunowolff/minimal-mcp-server",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A minimal Model Context Protocol (MCP) server template built with TypeScript, Vite, and Vitest",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "create": "bin/create-mcp-server.js"
  },
  "scripts": {
    "dev": "bun run build --watch",
    "build": "bun run type-check && vite build",
    "preview": "vite preview",
    "test": "bun test --parallel",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:server": "bun scripts/test-server.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "start": "bun dist/index.js",
    "prepublishOnly": "bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "bun audit --audit-level=high",
    "licenses": "bun pm licenses --prod"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "server",
    "typescript",
    "template",
    "ai",
    "claude",
    "anthropic"
  ],
  "author": "MCP Server Template Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrBrunoWolff/minimal-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/MrBrunoWolff/minimal-mcp-server/issues"
  },
  "homepage": "https://github.com/MrBrunoWolff/minimal-mcp-server#readme",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "bun@1.4.0"
}
